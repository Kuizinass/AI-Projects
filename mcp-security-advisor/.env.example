# ── Azure Tenant ──────────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id-here
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# ── Authentication ─────────────────────────────────────────────
# In production: leave blank — Managed Identity is used automatically.
# For local dev: set these to a service principal with equivalent permissions.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Microsoft Sentinel ────────────────────────────────────────
SENTINEL_WORKSPACE_ID=your-log-analytics-workspace-id
SENTINEL_WORKSPACE_NAME=your-sentinel-workspace-name
SENTINEL_RESOURCE_GROUP=your-resource-group

# ── Escalation: Microsoft Teams ───────────────────────────────
# Incoming Webhook URL for the security analyst Teams channel
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/...

# Optional: webhook endpoint on THIS server that Teams calls for Approve/Reject
TEAMS_CALLBACK_BASE_URL=https://your-mcp-server.azurecontainerapps.io

# ── Risk Thresholds (override defaults) ───────────────────────
# LOW_RISK_MAX=30
# MEDIUM_RISK_MAX=70
# HIGH_RISK_MAX=90

# ── Azure Monitor (Application Insights) ─────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# ── MCP Server ────────────────────────────────────────────────
MCP_SERVER_PORT=8080
LOG_LEVEL=INFO
